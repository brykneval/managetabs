{
  "manifest_version": 3,
  "name": "Manage Tab",
  "description": "Manages tabs for chrome",
  "version": "0.4",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_popup": "managetab.html",
    "default_title": "Manage Tabs"
  },
  "permissions": [
    "tabs",
    "storage",
    "pageCapture",
    "downloads",
    "downloads.open",
    "history"
  ]
}